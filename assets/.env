# ==========================================================================
# KAGUA - environment configuration (WORKING COPY)
# --------------------------------------------------------------------------
# Replace the YOUR_..._HERE placeholders with your real values.
# This file is git-ignored. See .env.example for the full explanation.
# ==========================================================================

APP_ENV=development

# Google Maps (https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY=AIzaSyAUPslkcnAeABgfaVZSig8duWnRQDczcIQ
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_ANDROID_GOOGLE_MAPS_API_KEY_HERE
GOOGLE_MAPS_API_KEY_IOS=YOUR_IOS_GOOGLE_MAPS_API_KEY_HERE
# Web / Chrome (Maps JavaScript API) - written into web/index.html by
# scripts\patch_platforms.cmd. Falls back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY_WEB=AIzaSyAUPslkcnAeABgfaVZSig8duWnRQDczcIQ

# Firebase (native config files - see FIREBASE_SETUP.md)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE

# RevenueCat (https://app.revenuecat.com)
REVENUECAT_ANDROID_API_KEY=YOUR_REVENUECAT_ANDROID_KEY_HERE
REVENUECAT_IOS_API_KEY=YOUR_REVENUECAT_IOS_API_KEY_HERE
